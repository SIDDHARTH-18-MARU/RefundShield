FROM python:3.14.10-alpine@sha256:a18b20ad69e74df6cf6d2e1b1a260d7a1ecf5380fd83b310f83ba88c461cf894
ENV PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY backend/requirements-test-linux.lock /tmp/test.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/test.lock \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.14/ensurepip \
    && rm /tmp/test.lock
COPY backend/app ./app
COPY backend/tests ./tests
USER 10001:10001
CMD ["python", "-m", "pytest", "tests", "-q", "-p", "no:cacheprovider"]
