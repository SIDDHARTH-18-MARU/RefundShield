FROM node:22.23.4-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202 AS builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.14.10-alpine@sha256:a18b20ad69e74df6cf6d2e1b1a260d7a1ecf5380fd83b310f83ba88c461cf894
LABEL org.opencontainers.image.title="RefundShield synthetic API" \
      org.opencontainers.image.authors="The Anomaly Syndicate"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY deploy/patch-runtime-zlib.sh /tmp/patch-runtime-zlib.sh
RUN /bin/sh /tmp/patch-runtime-zlib.sh && rm /tmp/patch-runtime-zlib.sh
COPY deploy/render-apk.sha256 /tmp/render-apk.sha256
RUN mkdir /tmp/render-apks \
    && cd /tmp/render-apks \
    && wget -q https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/nginx-1.30.6-r0.apk \
    && wget -q https://dl-cdn.alpinelinux.org/alpine/v3.24/main/x86_64/pcre2-10.49-r0.apk \
    && sha256sum -c /tmp/render-apk.sha256 \
    && apk add --no-cache ./nginx-1.30.6-r0.apk ./pcre2-10.49-r0.apk \
    && cd /app && rm -rf /tmp/render-apks /tmp/render-apk.sha256
COPY backend/requirements-runtime-linux.lock /tmp/runtime.lock
RUN python -m pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/runtime.lock \
    && python -m pip check \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.14/ensurepip \
    && rm /tmp/runtime.lock
COPY backend/app ./app
COPY NOTICE.md /licenses/NOTICE.md
COPY LICENSE /licenses/LICENSE
COPY docs/licenses/runtime /licenses/python-runtime
COPY --from=builder /build/dist /usr/share/nginx/html
COPY docs/licenses/frontend /licenses/frontend
COPY docs/licenses/fonts /licenses/fonts
COPY docs/licenses/render /licenses/render
COPY docs/licenses/alpine/zlib-LICENSE /licenses/alpine/zlib-LICENSE
COPY deploy/run-render.py deploy/render_app.py deploy/nginx.render.conf.template ./deployment/
USER 10001:10001
EXPOSE 10000
HEALTHCHECK --interval=15s --timeout=3s --start-period=120s --retries=3 \
  CMD origin="${REFUNDSHIELD_ORIGINS:-https://${RENDER_EXTERNAL_HOSTNAME}}"; wget -q -O - -T 2 --header "Host: ${origin#https://}" "http://127.0.0.1:${PORT:-10000}/healthz" | grep -qx ok
ENTRYPOINT ["python", "/app/deployment/run-render.py"]
