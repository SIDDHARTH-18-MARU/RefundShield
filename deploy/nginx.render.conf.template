worker_processes 1;
pid /tmp/refundshield/nginx.pid;
# Avoid logging request/query details in rate-limit/upstream diagnostics.
error_log /dev/stderr crit;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 20s;
    keepalive_timeout 5s;
    large_client_header_buffers 2 4k;
    client_body_temp_path /tmp/client;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    limit_req_zone $server_name zone=api_rate:1m rate=8r/s;
    limit_conn_zone $server_name zone=api_conn:1m;
    limit_req_status 429;
    limit_conn_status 429;
    map $uri $cache_policy { default "no-cache"; =/healthz "no-store"; ~^/assets/ "public, max-age=31536000, immutable"; }
    map $status $retry_after { default ""; 429 "60"; }
    upstream synthetic_api { server unix:/tmp/refundshield/api.sock; keepalive 8; }
    server {
        listen __PORT__ default_server;
        server_name _;
        return 404;
    }
    server {
        listen __PORT__;
        server_name __HOST__;
        root /usr/share/nginx/html;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Frame-Options DENY always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cache-Control $cache_policy always;
        add_header Retry-After $retry_after always;
        # Recharts/motion need inline styles. Scripts, fonts and API stay same-origin.
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'" always;
        location = /healthz {
            root /tmp/refundshield;
            try_files /ready =503;
        }
        location ^~ /api/ {
            # A 10-read sweep followed by a 12-read comparison is a valid workflow.
            # Preserve same-key parallel page reads. The ASGI adapter separately
            # bounds distinct analysis keys to four under the 0.1-CPU budget.
            limit_req zone=api_rate burst=32 nodelay;
            limit_conn api_conn 8;
            # Defense in depth: the unchanged API guard also denies mutations.
            if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }
            proxy_pass http://synthetic_api;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_connect_timeout 3s;
            proxy_read_timeout 20s;
            proxy_send_timeout 10s;
            proxy_max_temp_file_size 0;
            proxy_hide_header Server;
            proxy_hide_header Retry-After;
        }
        # API/docs/private paths never fall back to the SPA.
        location = /api { return 404; }
        location ~ (^/\.|^/(docs|redoc|openapi\.json|backend|frontend|private|security|qa|deploy)(/|$)|^/(README|NOTICE|CONTRIBUTORS)\.md$|\.(map|py|log|pem|key|zip|lock|toml|yaml)$) { return 404; }
        location /assets/ {
            try_files $uri =404;
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
